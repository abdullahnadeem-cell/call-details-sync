# Copy to .env (git-ignored). Values are read by python -m src.run when the real environment
# does not already define them.
SUPABASE_URL=https://hdwkfqjgnuahqmmaseor.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GADS_REPORT_URL=
# Google Ads ACCOUNT time zone (the report shows call times in it). Hawaii bucketing happens in the DB trigger.
GADS_ACCOUNT_TZ=America/Los_Angeles
# Local session: created by scripts/login_once.py (default file gads_session.json), or attach to a
# signed-in Chrome started with scripts/chrome.sh start:
# GADS_SESSION_FILE=gads_session.json
# GADS_CHROME_DEBUG_URL=127.0.0.1:9333
